# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your key. NEVER commit `.env`.
# The LLM is optional and used only for field extraction (see PLAN.md §1B, §6).
# ---------------------------------------------------------------------------

# Which provider to use: openai | anthropic | gemini | local
LADDER_LLM_PROVIDER=openai

# Model override (optional; sensible defaults per provider are built in)
LADDER_LLM_MODEL=gpt-4o-mini

# --- Pick ONE provider ------------------------------------------------
# openai
OPENAI_API_KEY=
# anthropic
# ANTHROPIC_API_KEY=
# gemini
# GEMINI_API_KEY=
# local (e.g. Ollama / LM Studio / vLLM, OpenAI-compatible)
# LADDER_LLM_BASE_URL=http://localhost:11434/v1

# Optional: a single explicit override that always wins over the provider vars
# LADDER_LLM_API_KEY=
